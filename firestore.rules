rules_version = '2';

// Estas son mis reglas de seguridad de Firestore para PediatriTrack Global.
// Cada documento guarda el campo "uid" del usuario que lo creó.
// Solo el dueño autenticado puede leer, actualizar o borrar su propio
// documento, y solo puede crear documentos con su propio uid.

service cloud.firestore {
  match /databases/{database}/documents {

    // esta función la hice para que un update solo se permita si YA eras
    // el dueño del documento y sigues siendo el dueño después del cambio
    // (o sea que el campo "uid" no se puede reasignar a otra cuenta).
    // Así nadie puede "regalar" o pasar sus documentos al uid de otra
    // persona con un update.
    function esActualizacionSinCambioDeDueno() {
      return request.auth != null
        && request.auth.uid == resource.data.uid
        && request.resource.data.uid == resource.data.uid;
    }

    match /bebes/{docId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow update: if esActualizacionSinCambioDeDueno();
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
    }

    match /vitaminas/{docId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow update: if esActualizacionSinCambioDeDueno();
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
    }

    match /documentos/{docId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow update: if esActualizacionSinCambioDeDueno();
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
    }

    match /alimentacion/{docId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow update: if esActualizacionSinCambioDeDueno();
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
    }

    match /vacunas_aplicadas/{docId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow update: if esActualizacionSinCambioDeDueno();
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
    }

    // fichas de salud con QR (pre-consulta y viaje). El id es un código
    // aleatorio de 48 caracteres que va dentro del QR. Cualquiera que tenga
    // ese código la puede LEER (sin cuenta, como el pediatra) solo mientras
    // esté activa y no haya vencido. Nadie puede listar fichas ajenas.
    match /fichas/{token} {
      allow get: if (request.auth != null && request.auth.uid == resource.data.uid)
        || (resource.data.activa == true && resource.data.expiraEn > request.time);
      allow list: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && token.matches('^[0-9a-f]{48}$')
        && request.resource.data.tipo in ['preconsulta', 'viaje']
        && request.resource.data.activa == true
        && request.resource.data.expiraEn is timestamp
        && request.resource.data.expiraEn < request.time + duration.value(91, 'd');
      // el dueño solo puede apagarla (no alargarla ni cambiarle los datos)
      allow update: if esActualizacionSinCambioDeDueno()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activa'])
        && request.resource.data.activa == false;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
    }

    // cualquier otra colección que no esté arriba queda bloqueada por default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
