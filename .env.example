# =====================================================
# PEDIATRITRACK GLOBAL - VARIABLES DE ENTORNO
# =====================================================
# PLANTILLA sin llaves reales (esta sí se sube al repo).
# Cópiala como .env.local y llena los valores.
#
# OJO: en Expo todo lo que empieza con EXPO_PUBLIC_ se mete dentro de la
# app (el APK/AAB), así que aquí SOLO van llaves que pueden vivir en el
# celular. Nada de llaves de paga tipo Twilio o SendGrid, esas necesitan
# un servidor (como en MediCore).
#
# Después de cambiar algo aquí hay que reiniciar Expo:  npx expo start -c
# Para que el build de Play Store (EAS) también las tenga:
#   eas env:push production --path .env.local --force

# ---------- FIREBASE (Auth, Firestore, Storage) ----------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ---------- GOOGLE GEMINI (asistente virtual / chatbot) ----------
# Pega aqui tu llave de https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.5-flash-lite

# ---------- VOZ DE PEDI (OPCIONAL) ----------
# Pedi lee sus respuestas con la voz de Gemini usando la misma llave de
# arriba. Si quieres cambiar la voz o el modelo, quita el # de estas lineas.
# Voces que suenan bien para Pedi: Leda, Aoede, Laomedeia, Achird, Sulafat
# EXPO_PUBLIC_GEMINI_TTS_VOICE=Leda
# EXPO_PUBLIC_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# ---------- OPENAI (respaldo del chatbot si Gemini falla, OPCIONAL) ----------
# Es de paga (hay que cargar saldo). Si se deja comentada, el chatbot
# funciona normal solo con Gemini. Para usarla quita el # de las dos lineas.
# EXPO_PUBLIC_OPENAI_API_KEY=
# EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini

# ---------- OPENFDA (info de medicamentos y vacunas, OPCIONAL) ----------
# Funciona sin llave. Con una llave gratis de
# https://open.fda.gov/apis/authentication/ sube el limite de consultas.
# EXPO_PUBLIC_OPENFDA_API_KEY=
